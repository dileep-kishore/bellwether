{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/deny-dangerous.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ": orca-agent-hook-form=1; \"$HOME/.orca/hooks/agent-hook.sh\" PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ": orca-agent-hook-form=1; \"$HOME/.orca/hooks/agent-hook.sh\" SubagentStart",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
