#!/bin/sh
# Stands in for hc in tests: `exec` and `file write` with FAKE_HC_ROOT as that machine's home, `get`, `ls`,
# `send`, `read` and `keys` against canned terminals, `run --bg`, `kill` and `rm` of real background
# programs, and `machine ls`.
#   FAKE_HC_UNAME         what `uname -sm` prints there
#   FAKE_HC_CORRUPT_PART  N: the write of a file ending in .partN lands with its first byte changed
#   FAKE_HC_OFFLINE       1: every call fails as hc does for a machine it cannot reach
#   FAKE_HC_LOG           each call is appended here as "<command> <args>"
#   FAKE_HC_EXEC_OUT      a file: `exec` prints it as the program's stdout instead of running anything
#   FAKE_HC_GET_DIR       `get <addr>` prints <addr with / as _>.json from here, or .after.json beside it once
#                         FAKE_HC_LOG holds a `read` of that terminal; else fails not_found
#   FAKE_HC_LS            a file: what `ls` prints, else {"terminals":[]}
#   FAKE_HC_SEND_SLEEP    seconds `send` waits before answering
#   FAKE_HC_SEND_FAIL     a kind: `send` fails with it (blocked, finished, not_found, machine_unknown, ...)
#   FAKE_HC_SCREEN_DIR    `read <addr>` prints <addr with / as _>.txt from here, .next.txt beside it from the
#                         second read on, or .after.txt once FAKE_HC_LOG holds a `keys` call to that terminal;
#                         else fails not_found
#   FAKE_HC_KEYS_SLEEP    seconds `keys` waits before answering
#   FAKE_HC_KEYS_FAIL     a kind: `keys` fails with it
#   FAKE_HC_MACHINES      a file: what `machine ls` prints, else {"machines":[]}
#   FAKE_HC_RUN_DIR       `run --bg` starts its program here in a process group of its own, keeping
#                         <name>.pid, .argv (a JSON array) and .out; `get`, `ls`, `kill` and `rm` see those
#                         terminals, live while the pid is; `run --on` starts it in FAKE_HC_ROOT with that
#                         as HOME, and `--rm` is accepted but leaves the files for the test to read
# Argument shapes are the ones bw sends; anything else exits 2 so a changed call shows up in a test.
set -u
log=${FAKE_HC_LOG:-/dev/null}

fail() {
  printf '{"error":{"hint":"","kind":"%s","message":"%s"}}\n' "$1" "$2" >&2
  exit "$3"
}
b64() { base64 < "$1" | tr -d '\n'; }
# A plain-text file as a JSON string's contents: lines joined by \n, the last newline dropped.
json_text() {
  tab=$(printf '\t') cr=$(printf '\r')
  LC_ALL=C sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$tab/\\\\t/g" -e "s/$cr/\\\\r/g" "$1" |
    LC_ALL=C awk 'NR > 1 { printf "%s", "\\n" } { printf "%s", $0 }'
}
json_str() { printf '"%s"' "$(printf '%s' "$1" | LC_ALL=C sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }
run_dir=${FAKE_HC_RUN_DIR:-/nonexistent}
# A terminal that `run` started: its JSON, live while its process group's leader runs.
ran() {
  [ -f "$run_dir/$1.pid" ] || return 1
  pid=$(cat "$run_dir/$1.pid") state=finished
  kill -0 "$pid" 2>/dev/null && state=live
  printf '{"address":"t%s","name":"%s","argv":%s,"pid":%s,"state":"%s"}\n' \
    "$pid" "$1" "$(cat "$run_dir/$1.argv")" "$pid" "$state"
}
offline() {
  [ "${FAKE_HC_OFFLINE:-}" = 1 ] && fail machine_offline "machine ${1:-here} is not connected" 4
  return 0
}

[ $# -gt 0 ] || fail usage "no command" 2
cmd=$1
shift

# get, ls, send, read and keys: --on is optional; send's text and keys' names are taken verbatim after `--`.
case $cmd in
  machine)
    [ "$*" = "ls --json" ] || fail usage "machine takes ls --json" 2
    echo "machine ls" >> "$log"
    if [ -n "${FAKE_HC_MACHINES:-}" ]; then cat "$FAKE_HC_MACHINES"; else echo '{"machines":[]}'; fi
    exit 0
    ;;
  run)
    name= cwd= bg=0 json=0 on=
    while [ $# -gt 0 ]; do
      case $1 in
        --bg) bg=1; shift ;;
        --json) json=1; shift ;;
        --no-parent|--no-notify|--rm) shift ;;
        --on) on=${2:-}; shift 2 ;;
        --name) name=${2:-}; shift 2 ;;
        --cwd) cwd=${2:-}; shift 2 ;;
        --) shift; break ;;
        *) fail usage "unexpected argument $1" 2 ;;
      esac
    done
    # With --on, hc's default folder is that machine's home.
    if [ -n "$on" ] && [ -z "$cwd" ]; then cwd=${FAKE_HC_ROOT:?FAKE_HC_ROOT is not set}; fi
    [ "$bg" = 1 ] && [ "$json" = 1 ] && [ -n "$name" ] && [ -n "$cwd" ] && [ $# -gt 0 ] ||
      fail usage "run takes --bg --json --name --cwd -- <argv>" 2
    echo "run $name $*" >> "$log"
    [ -d "$run_dir" ] || fail usage "FAKE_HC_RUN_DIR is not set" 2
    if [ -f "$run_dir/$name.pid" ] && kill -0 "$(cat "$run_dir/$name.pid")" 2>/dev/null; then
      fail name_taken "a live terminal is named $name" 1
    fi
    argv= sep=
    for a in "$@"; do argv="$argv$sep$(json_str "$a")"; sep=,; done
    printf '[%s]' "$argv" > "$run_dir/$name.argv"
    # Job control gives the program its own process group, so `kill` ends it and its children together.
    set -m
    if [ -n "$on" ]; then
      (cd "$cwd" && HOME=$FAKE_HC_ROOT exec "$@") < /dev/null > "$run_dir/$name.out" 2>&1 &
    else
      (cd "$cwd" && exec "$@") < /dev/null > "$run_dir/$name.out" 2>&1 &
    fi
    echo $! > "$run_dir/$name.pid"
    set +m
    ran "$name"
    exit 0
    ;;
  get|ls|send|read|keys|kill|rm)
    machine= json=0 rest=
    while [ $# -gt 0 ]; do
      case $1 in
        --json) json=1; shift ;;
        --on=*) machine=${1#--on=}; shift ;;
        --on) machine=${2:-}; shift 2 ;;
        --) shift; break ;;
        --force) fail usage "bw never sends --force" 2 ;;
        -*) fail usage "unexpected argument $1" 2 ;;
        *) case $cmd in send|keys) fail usage "$cmd needs -- before the address" 2 ;; esac
           [ -z "$rest" ] || fail usage "unexpected argument $1" 2
           rest=$1; shift ;;
      esac
    done
    [ "$json" = 1 ] || fail usage "no --json" 2
    case $cmd in
      get)
        [ $# -eq 0 ] && [ -n "$rest" ] || fail usage "get takes one terminal" 2
        echo "get $rest" >> "$log"
        offline "$machine"
        ran "$rest" && exit 0
        base=${FAKE_HC_GET_DIR:-/nonexistent}/$(printf '%s' "$rest" | tr / _)
        file=$base.json
        if [ -f "$base.after.json" ] && grep -qxF -- "read $rest" "$log" 2>/dev/null; then
          file=$base.after.json
        fi
        [ -f "$file" ] || fail not_found "no terminal $rest" 1
        cat "$file"
        ;;
      ls)
        [ $# -eq 0 ] && [ -z "$rest" ] || fail usage "ls takes no terminal" 2
        echo "ls" >> "$log"
        offline "$machine"
        if [ -n "${FAKE_HC_LS:-}" ]; then
          cat "$FAKE_HC_LS"
        else
          rows= sep=
          for f in "$run_dir"/*.pid; do
            [ -f "$f" ] || continue
            row=$(ran "$(basename "$f" .pid)")
            case $row in *'"state":"live"'*) rows="$rows$sep$row"; sep=, ;; esac
          done
          printf '{"terminals":[%s]}\n' "$rows"
        fi
        ;;
      kill)
        [ $# -eq 0 ] && [ -n "$rest" ] || fail usage "kill takes one terminal" 2
        echo "kill $rest" >> "$log"
        offline "$machine"
        [ -f "$run_dir/$rest.pid" ] || fail not_found "no terminal $rest" 3
        pid=$(cat "$run_dir/$rest.pid") n=50
        kill -HUP -- "-$pid" 2>/dev/null
        while kill -0 "$pid" 2>/dev/null && [ "$n" -gt 0 ]; do sleep 0.1; n=$((n - 1)); done
        kill -KILL -- "-$pid" 2>/dev/null
        ran "$rest"
        ;;
      rm)
        [ $# -eq 0 ] && [ -n "$rest" ] || fail usage "rm takes one terminal" 2
        echo "rm $rest" >> "$log"
        offline "$machine"
        [ -f "$run_dir/$rest.pid" ] || fail not_found "no terminal $rest" 3
        pid=$(cat "$run_dir/$rest.pid")
        kill -0 "$pid" 2>/dev/null && fail status_mismatch "terminal $rest is still live" 1
        rm -f "$run_dir/$rest.pid" "$run_dir/$rest.argv" "$run_dir/$rest.out"
        printf '{"removed":"t%s"}\n' "$pid"
        ;;
      send)
        [ $# -eq 2 ] || fail usage "send takes -- <terminal> <text>" 2
        printf 'send %s %s\n' "$1" "$2" >> "$log"
        offline "$machine"
        sleep "${FAKE_HC_SEND_SLEEP:-0}"
        [ -n "${FAKE_HC_SEND_FAIL:-}" ] && fail "$FAKE_HC_SEND_FAIL" "terminal $1 refused: $FAKE_HC_SEND_FAIL" 1
        echo '{"started":1,"status":"working","turn":1}'
        ;;
      read)
        [ $# -eq 0 ] && [ -n "$rest" ] || fail usage "read takes one terminal" 2
        echo "read $rest" >> "$log"
        offline "$machine"
        base=${FAKE_HC_SCREEN_DIR:-/nonexistent}/$(printf '%s' "$rest" | tr / _)
        file=$base.txt
        reads=$(grep -cxF -- "read $rest" "$log" 2>/dev/null)
        if [ -f "$base.next.txt" ] && [ "${reads:-0}" -ge 2 ]; then
          file=$base.next.txt
        fi
        if [ -f "$base.after.txt" ] && grep -qF -- "keys $rest " "$log" 2>/dev/null; then
          file=$base.after.txt
        fi
        [ -f "$file" ] || fail not_found "no terminal $rest" 1
        printf '{"complete":true,"how":"screen","text":"%s"}\n' "$(json_text "$file")"
        ;;
      keys)
        [ $# -ge 2 ] || fail usage "keys takes -- <terminal> <key>..." 2
        addr=$1
        shift
        echo "keys $addr $*" >> "$log"
        offline "$machine"
        sleep "${FAKE_HC_KEYS_SLEEP:-0}"
        [ -n "${FAKE_HC_KEYS_FAIL:-}" ] && fail "$FAKE_HC_KEYS_FAIL" "terminal $addr refused: $FAKE_HC_KEYS_FAIL" 1
        echo '{"turn":1,"status":"working"}'
        ;;
    esac
    exit 0
    ;;
esac

root=${FAKE_HC_ROOT:?FAKE_HC_ROOT is not set}
if [ "$cmd" = file ]; then
  cmd="file ${1:-}"
  shift
fi
machine=
while [ $# -gt 0 ]; do
  case $1 in
    --json) shift ;;
    --on=*) machine=${1#--on=}; shift ;;
    --timeout=*) shift ;;
    --) shift; break ;;
    *) fail usage "unexpected argument $1" 2 ;;
  esac
done
[ -n "$machine" ] || fail usage "no --on" 2
[ $# -gt 0 ] || fail usage "nothing to run or write" 2
echo "$cmd $*" >> "$log"
offline "$machine"

case $cmd in
  exec)
    if [ -n "${FAKE_HC_EXEC_OUT:-}" ]; then
      out=$(mktemp) err=$(mktemp)
      cat "$FAKE_HC_EXEC_OUT" > "$out"
      code=0
    elif [ "$*" = "uname -sm" ] && [ -n "${FAKE_HC_UNAME:-}" ]; then
      out=$(mktemp) err=$(mktemp)
      printf '%s\n' "$FAKE_HC_UNAME" > "$out"
      code=0
    elif ! command -v "$1" >/dev/null 2>&1; then
      fail spawn_failed "cannot start $1: No such file or directory (os error 2)" 1
    else
      out=$(mktemp) err=$(mktemp)
      (cd "$root" && HOME=$root exec "$@") > "$out" 2> "$err"
      code=$?
    fi
    printf '{"code":%d,"ms":0,"signal":null,"stderr":"%s","stdout":"%s","timed_out":false,"truncated":false}\n' \
      "$code" "$(b64 "$err")" "$(b64 "$out")"
    rm -f "$out" "$err"
    ;;
  "file write")
    path=$root/$1
    mkdir -p "$(dirname "$path")"
    cat > "$path"
    case $1 in
      *.part"${FAKE_HC_CORRUPT_PART:-none}")
        printf x | dd of="$path" bs=1 count=1 conv=notrunc 2>/dev/null ;;
    esac
    printf '{"bytes":%d,"path":"%s"}\n' "$(($(wc -c < "$path")))" "$path"
    ;;
  *) fail usage "unknown command $cmd" 2 ;;
esac
