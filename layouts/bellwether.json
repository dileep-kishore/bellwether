{
  "id": "root",
  "type": "row",
  "theme": "bellwether",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 248
      },
      "min": 160,
      "max": 480,
      "background": "chrome",
      "children": [
        {
          "id": "projects",
          "type": "block",
          "content": {
            "mod": "bw-projects"
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 32
          },
          "window_drag": true,
          "content": {
            "mod": "bw-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    },
    {
      "id": "right",
      "type": "column",
      "size": {
        "px": 360
      },
      "min": 280,
      "max": 900,
      "background": "chrome",
      "children": [
        {
          "id": "right-strip",
          "type": "block",
          "size": {
            "px": 36
          },
          "content": {
            "mod": "bw-right"
          }
        },
        {
          "id": "right-body",
          "type": "stack",
          "active": "changes",
          "children": [
            {
              "id": "changes",
              "type": "block",
              "content": {
                "mod": "bw-right",
                "props": {
                  "panel": "changes"
                }
              }
            },
            {
              "id": "issues",
              "type": "block",
              "content": {
                "mod": "bw-right",
                "props": {
                  "panel": "issues"
                }
              }
            },
            {
              "id": "browser",
              "type": "block",
              "content": {
                "mod": "bw-browser"
              }
            }
          ]
        }
      ]
    }
  ],
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  }
}
