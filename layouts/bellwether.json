{
  "id": "root",
  "type": "row",
  "theme": "bellwether",
  "preview": "layouts/bellwether.svg",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 244
      },
      "min": 200,
      "max": 420,
      "background": "chrome",
      "children": [
        {
          "id": "projects",
          "type": "block",
          "content": {
            "mod": "bw-projects"
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 40
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "background": "surface",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 48
          },
          "window_drag": true,
          "content": {
            "mod": "bw-tabs"
          }
        },
        {
          "id": "screen",
          "type": "stack",
          "active": "chat",
          "floating": [
            {
              "id": "sidebar-peek",
              "content": {
                "mod": "bw-projects",
                "props": {
                  "peek": true
                }
              },
              "edge": "left",
              "align": "start",
              "peek": 6
            }
          ],
          "children": [
            {
              "id": "chat",
              "type": "block",
              "content": {
                "mod": "bw-chat"
              }
            },
            {
              "id": "panes",
              "type": "block",
              "padding": 8,
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": false,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "bw-pane"
                    },
                    "height": 28,
                    "position": "top",
                    "reveal": "hover"
                  }
                }
              }
            },
            {
              "id": "needs",
              "type": "block",
              "content": {
                "mod": "bw-needs"
              }
            },
            {
              "id": "overview",
              "type": "block",
              "content": {
                "mod": "bw-overview"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "right",
      "type": "column",
      "hidden": true,
      "size": {
        "px": 380
      },
      "min": 280,
      "max": 620,
      "background": "chrome",
      "children": [
        {
          "id": "right-strip",
          "type": "block",
          "size": {
            "px": 36
          },
          "content": {
            "mod": "bw-right"
          }
        },
        {
          "id": "right-body",
          "type": "stack",
          "active": "changes",
          "children": [
            {
              "id": "changes",
              "type": "block",
              "content": {
                "mod": "bw-diff"
              }
            },
            {
              "id": "issues",
              "type": "block",
              "content": {
                "mod": "bw-linear"
              }
            },
            {
              "id": "drafts",
              "type": "block",
              "content": {
                "mod": "bw-drafts"
              }
            },
            {
              "id": "browser",
              "type": "block",
              "content": {
                "mod": "bw-browser"
              }
            }
          ]
        }
      ]
    }
  ],
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  }
}
